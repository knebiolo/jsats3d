# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Environments & IDEs
.spyproject/
*.jupyterlab-workspace
.venv/
env/
venv/
.vscode/

# Test cache
.pytest_cache/

# SQLite databases & temp artifacts
*.db
*.sqlite
*.sqlite3
*.log

# All generated outputs — never commit
output/
!output/.gitkeep

# Local copies of raw input data (large, read from K:)
data/*
!data/README.md

# Legacy standalone scripts (replaced by legacy_pipeline.py, kept for reference)
scripts/metronome.py
scripts/mulitpath.py

# Diagnostic / standalone scripts (not part of pipeline)
scripts/check_hold_times.py
scripts/debug_static_hold.py
scripts/plot_fish_tracks.py
scripts/score_static_holds.py
